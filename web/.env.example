# Copy this file to .env.local for local development.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# NEVER prefix this with NEXT_PUBLIC_ and never commit the real key.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The application's verified default is gemini-3.8-flash.
# Only use a model available in your own Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash

# For Vercel, add GEMINI_API_KEY (and optionally GEMINI_MODEL) in
# Project Settings -> Environment Variables, then redeploy.
