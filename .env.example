# Copy this file to .env and replace the placeholder with your own key.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# Never commit .env to Git.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. gemini-3.8-flash is the verified default for this project.
GEMINI_MODEL=gemini-3.8-flash

# Optional. Defaults to data/study_planner.db inside the project.
# STUDY_PLANNER_DB=data/study_planner.db
